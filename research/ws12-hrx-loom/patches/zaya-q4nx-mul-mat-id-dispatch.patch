 ggml/src/ggml-cpu/ggml-cpu.c     |  19 ---
 ggml/src/ggml-cpu/ggml-cpu.cpp   |   5 +
 ggml/src/ggml-hrx2/ggml-hrx2.cpp | 254 ++++++++++++++++++++++++++-----
 ggml/src/ggml.c                  |  50 +++++-
 5 files changed, 276 insertions(+), 63 deletions(-)

