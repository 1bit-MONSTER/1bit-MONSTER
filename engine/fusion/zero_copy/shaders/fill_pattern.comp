// fill_pattern.comp — fill a u32 buffer with 0xBEEF0000 ^ i.
// Used by test_vk_dma_buf_import to prove a Vulkan compute shader can write
// directly into NPU-owned SharedBO pages (dma-buf import, #1215/#1217).
#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) buffer OutBuf {
    uint data[];
} out_buf;

void main() {
    uint i = gl_GlobalInvocationID.x;
    out_buf.data[i] = 0xBEEF0000u ^ i;
}
