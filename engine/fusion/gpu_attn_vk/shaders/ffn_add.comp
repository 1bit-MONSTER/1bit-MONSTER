// ffn_add.comp — FFN residual add: h[i] = res[i] + down[i] (h = the saved
// pre-RMSNorm residual + the down projection).  In place on the pages.
#version 450
layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) buffer Pages { float h[]; };   // [H]
layout(set = 0, binding = 1, std430) buffer Res   { float res[]; }; // [H]
layout(set = 0, binding = 2, std430) buffer Down  { float d[]; };   // [H]

layout(push_constant) uniform PC {
    int  H; int NH; int NKV; int HD; int IM;
    int  pos; int layer; int max_seq;
    float eps; float rope_theta; float scale;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.H)) return;
    h[i] = res[i] + d[i];
}
