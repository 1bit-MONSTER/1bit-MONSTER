#version 460
// Group RMSNorm for Mamba2 SSM output, one workgroup per group.
// Matches mamba2_cpu_forward() step 5b exactly:
//   group_size = d_inner / n_group
//   for group g: rms = sqrt(sum_sq / group_size + eps)
//     y[i] = (y[i] / rms) * norm_w[g + i*n_group]     (norm_w is [group_size, n_group])
// eps is 1e-6 in the CPU reference (hardcoded, distinct from cfg.rms_norm_eps).
//
// Buffer 0 (R/W, in-place): y_inner [d_inner].
// Buffer 2 (readonly): norm_w [d_inner] (column-major per group).
// Push: M=d_inner, N=n_group, K=group_size, eps in pc.eps.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) buffer X { float x[]; };
layout(std430, binding = 2) readonly buffer Wt { float w[]; };
layout(push_constant) uniform Push { uint M, N, K, s; float sc, eps, th, p; int tok, l, h, pos; } pc;
shared float part[256];

void main() {
    uint g = gl_WorkGroupID.x;
    if (g >= pc.N) return;
    uint tid = gl_LocalInvocationID.x;
    uint n = pc.K;                 // group_size
    uint base = g * n;

    float ss = 0.0;
    for (uint i = tid; i < n; i += 256u) {
        float v = x[base + i];
        ss += v * v;
    }
    part[tid] = ss;
    barrier();
    for (uint sz = 128u; sz > 0u; sz >>= 1u) {
        if (tid < sz) part[tid] += part[tid + sz];
        barrier();
    }
    float rms = inversesqrt(part[0] / float(n) + pc.eps);

    for (uint i = tid; i < n; i += 256u) {
        x[base + i] = x[base + i] * rms * w[g + i * pc.N];
    }
}
