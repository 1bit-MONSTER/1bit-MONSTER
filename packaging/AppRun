#!/bin/sh
HERE="$(dirname "$(readlink -f "$0")")"
export PATH="$HERE/usr/bin:$PATH"
export LD_LIBRARY_PATH="$HERE/usr/lib:$HERE/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH"
# The engine's HIP/Vulkan backends link against TheRock (ROCm) runtime libs.
# Add the standard install locations when present so the AppImage works on
# machines that have TheRock installed (the appliance ISO installs it to
# /opt/rocm-therock). Absent on machines without TheRock — the binary then
# fails fast with a clear linker error instead of a cryptic one.
for d in \
    /opt/rocm-therock/_rocm_sdk_devel/lib \
    /opt/rocm-therock/_rocm_sdk_libraries/lib \
    /opt/rocm-therock/_rocm_sdk_core/lib \
    /opt/rocm-therock/_rocm_sdk_core/lib/llvm/lib; do
    [ -d "$d" ] && export LD_LIBRARY_PATH="$d:$LD_LIBRARY_PATH"
done
exec "$HERE/usr/bin/1bit" "$@"
