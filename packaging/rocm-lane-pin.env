# 1bit.systems — single source of truth for the ROCm/TheRock inference lane.
#
# Sourced by:
#   - scripts/setup-therock.sh      (live Ubuntu setup, pinned installer)
#   - install.sh                    (curl-piped installer)
#   - packaging/iso/fetch-payload.sh (appliance ISO driver payload)
#   - packaging/iso/build.sh        (appliance ISO build)
#
# Bump a pin HERE, then rebuild the ISO payload (packaging/iso/fetch-payload.sh)
# and re-run the live setup (scripts/setup-therock.sh). The appliance ISO
# bakes these exact versions in so "proper inference drivers out of the box"
# holds without any post-install setup. See docs/rocm-lanes.md (pin contract)
# and docs/superpowers/specs/2026-08-16-ubuntu-iso-design.md.

# TheRock AI-inference SDK pin. Ubuntu's default classic ROCm (7.2.x,
# amdgpu-install) is the enterprise-supported line — NOT what inference runs
# on. Same build the appliance ISO ships; held, never resolved live.
THEROCK_VERSION="${THEROCK_VERSION:-7.14.0a20260612}"
GPU_TARGET="${GPU_TARGET:-gfx1151}"
ROCK_ROOT="${ROCK_ROOT:-/opt/rocm-therock}"
NIGHTLY_INDEX="${NIGHTLY_INDEX:-https://rocm.nightlies.amd.com/whl-multi-arch/}"

# Classic-line apt pins baked into the appliance ISO (held via apt-mark hold)
# so a later `apt upgrade` cannot drift the driver stack.
MESA_VER="${MESA_VER:-26.0.3-1ubuntu1}"
VULKAN1_VER="${VULKAN1_VER:-1.4.341.0-1}"

# Appliance ISO base
UBUNTU_VER="${UBUNTU_VER:-26.04}"
